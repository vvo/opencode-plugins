{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "missing": [{ "type": "header", "key": "user-agent", "value": "(?i).*slack.*" }],
      "destination": "https://github.com/:path*",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/:path*", "destination": "/empty.html" }],
  "headers": [{ "source": "/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }]
}
