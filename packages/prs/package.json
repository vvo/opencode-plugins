{
  "name": "opencode-prs",
  "version": "0.1.5",
  "description": "OpenCode TUI plugin that shows GitHub pull requests referenced by the current session",
  "type": "module",
  "exports": { ".": "./dist/index.js", "./tui": "./dist/tui.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "test": "npm run build && node --test test/prs.test.js",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": ["opencode", "opencode-plugin", "github", "pull-request", "tui"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvo/opencode-plugins.git",
    "directory": "packages/prs"
  },
  "homepage": "https://github.com/vvo/opencode-plugins/tree/main/packages/prs#readme",
  "author": "Vincent Voyer <vincent@codeagain.com>",
  "license": "MIT",
  "engines": { "opencode": ">=1.18.0" },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "1.18.25",
    "@opentui/core": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "^1.9.12",
    "plugin-v2": "npm:@opencode-ai/plugin@0.0.0-beta-19086",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3"
  }
}
