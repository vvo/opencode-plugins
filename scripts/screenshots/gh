#!/usr/bin/env python3
"""Fake gh for screenshots: canned answers for the batched pull request GraphQL query, its check runs query and its REST fallback."""
import json, re, sys

PRS = {
    37: {
        "title": "[opencode-prs] Show review state, comments and checks per PR",
        "state": "OPEN", "isDraft": False, "reviewDecision": "APPROVED", "mergeStateStatus": "CLEAN",
        "createdAt": "2026-09-17T09:12:00Z", "mergedAt": None,
        "additions": 214, "deletions": 38, "checks": "SUCCESS", "unresolved": 0,
    },
    212: {
        "title": "Update time zone database to 2026b",
        "state": "OPEN", "isDraft": False, "reviewDecision": "APPROVED", "mergeStateStatus": "DIRTY",
        "createdAt": "2026-09-17T08:40:00Z", "mergedAt": None,
        "additions": 61, "deletions": 9, "checks": "SUCCESS", "unresolved": 0,
    },
    39: {
        "title": "Update the package publishing workflow",
        "state": "OPEN", "isDraft": False, "reviewDecision": "APPROVED", "mergeStateStatus": "UNKNOWN",
        "createdAt": "2026-09-17T08:05:00Z", "mergedAt": None,
        "additions": 12, "deletions": 4, "checks": "IN_PROGRESS", "unresolved": 1,
    },
    35: {
        "title": "[opencode-prs] Refresh PRs faster and update copied reviews",
        "state": "MERGED", "isDraft": False, "reviewDecision": "APPROVED", "mergeStateStatus": "CLEAN",
        "createdAt": "2026-09-16T15:20:00Z", "mergedAt": "2026-09-16T17:02:00Z",
        "additions": 133, "deletions": 57, "checks": "SUCCESS", "unresolved": 0,
    },
}

def suite_id(number):
    return f"CS_{number}"

def suite(number):
    """One check suite holding a single check named `test` in the PR's state."""
    kind = PRS[number]["checks"]
    return {
        "id": suite_id(number),
        "status": "IN_PROGRESS" if kind == "IN_PROGRESS" else "COMPLETED",
        "conclusion": None if kind == "IN_PROGRESS" else kind,
        "workflowRun": None,
    }

def suite_runs(number):
    kind = PRS[number]["checks"]
    failing = ["test"] if kind == "FAILURE" else []
    running = ["test"] if kind == "IN_PROGRESS" else []
    return {
        "id": suite_id(number),
        "failing": {"totalCount": len(failing), "nodes": [{"name": n} for n in failing]},
        "running": {"totalCount": len(running), "nodes": [{"name": n} for n in running]},
    }

def node(owner, repo, number):
    pr = PRS[number]
    return {
        "title": pr["title"], "state": pr["state"], "number": number,
        "url": f"https://github.com/{owner}/{repo}/pull/{number}",
        "isDraft": pr["isDraft"], "reviewDecision": pr["reviewDecision"], "mergeStateStatus": pr["mergeStateStatus"],
        "createdAt": pr["createdAt"], "mergedAt": pr["mergedAt"],
        "additions": pr["additions"], "deletions": pr["deletions"],
        "reviewThreads": {"nodes": [{"isResolved": False}] * pr["unresolved"]},
        "commits": {"nodes": [{"commit": {
            "statusCheckRollup": {"contexts": {
                "checkRunCountsByState": [{"state": "SUCCESS", "count": 1}] if pr["checks"] == "SUCCESS" else [],
                "statusContextCountsByState": [],
            }},
            "checkSuites": {"nodes": [suite(number)]},
        }}]},
    }

args = sys.argv[1:]
if args[:2] == ["api", "graphql"]:
    query = next(a for a in args if a.startswith("query=")).removeprefix("query=")
    ids = re.search(r"nodes\(ids: (\[[^\]]*\])\)", query)
    if ids:
        print(json.dumps({"data": {"nodes": [suite_runs(int(i.removeprefix("CS_"))) for i in json.loads(ids.group(1))]}}))
        sys.exit(0)
    aliases = re.findall(r'(pr\d+): repository\(owner: "([^"]+)", name: "([^"]+)"\) \{ pullRequest\(number: (\d+)\)', query)
    data = {alias: {"pullRequest": node(owner, repo, int(number))} for alias, owner, repo, number in aliases}
    print(json.dumps({"data": data}))
elif args[:1] == ["api"] and re.fullmatch(r"repos/[^/]+/[^/]+/pulls/\d+", args[1]):
    number = int(args[1].rsplit("/", 1)[1])
    pr = PRS[number]
    print(json.dumps({
        "title": pr["title"], "state": "open" if pr["state"] == "OPEN" else "closed",
        "draft": pr["isDraft"], "created_at": pr["createdAt"], "merged_at": pr["mergedAt"],
        "additions": pr["additions"], "deletions": pr["deletions"],
    }))
else:
    sys.stderr.write(f"fake gh: unsupported {args}\n")
    sys.exit(1)
